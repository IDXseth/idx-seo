// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  password      String?        // null for OAuth users
  gscSiteUrl    String?        // selected Google Search Console property URL — SQL: ALTER TABLE "User" ADD COLUMN IF NOT EXISTS "gscSiteUrl" TEXT;
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  batches       Batch[]
  projects      Project[]
  sharedBatches ProjectShare[]
  competitors   Competitor[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProjectShare {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  email     String   // invited email
  userId    String?  // set when the invited user signs up/logs in
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([batchId, email])
}

// A tracked brand: one primary domain plus the brand names and competitors
// that AI responses are scored against. Batches (prompt uploads) belong to a project.
model Project {
  id                String       @id @default(cuid())
  name              String
  primaryDomain     String       // bare hostname, e.g. "seniorlifestyle.com" (no protocol, no www)
  additionalDomains String[]     @default([])  // other owned hostnames counted as citations
  brandNames        String[]     @default([])  // names/aliases matched as brand mentions
  sitemapUrl        String?
  sitemapPathPrefix String?
  gscSiteUrl        String?
  segmentLabels     Json?        // display labels for Prompt.segments keys, e.g. {"market":"Market"}
  logoUrl           String?
  brandColor        String?
  userId            String       // owner
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitors       Competitor[]
  batches           Batch[]
  prompts           Prompt[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([userId, primaryDomain])
}


model Batch {
  id          String         @id @default(cuid())
  name        String
  fileName    String
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?        // nullable until every batch is backfilled — see scripts/backfill-projects.ts
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isPrivate   Boolean        @default(true)
  shareToken  String?        @unique @default(cuid())
  prompts     Prompt[]
  shares      ProjectShare[]
  runs        BatchRun[]
  runSessions RunSession[]
  schedules   Schedule[]
  createdAt   DateTime       @default(now())

  @@index([projectId])
}

model BatchRun {
  id           String      @id @default(cuid())
  batchId      String?
  batch        Batch?      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  runSessionId String?
  runSession   RunSession? @relation(fields: [runSessionId], references: [id])
  totalPrompts Int
  doneCount    Int         @default(0)
  failCount    Int         @default(0)
  notifyEmail  String?
  status       String      @default("running")  // "running" | "done"
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
}

model RunSession {
  id          String     @id @default(cuid())
  batchId     String?
  batch       Batch?     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  triggeredBy String     @default("manual")  // "manual" | "scheduled"
  scheduleId  String?
  schedule    Schedule?  @relation(fields: [scheduleId], references: [id])
  status      String     @default("running")  // "running" | "done"
  batchRuns   BatchRun[]
  results     Result[]
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
}

model Schedule {
  id          String       @id @default(cuid())
  batchId     String
  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  frequency   String       // "daily" | "weekly" | "monthly" | "custom"
  customDays  Int?         // days between runs, for "custom"
  dayOfWeek   Int?         // 0–6 (Sun=0), for "weekly"
  dayOfMonth  Int?         // 1–31, for "monthly"
  hour        Int          @default(9)
  timezone    String       @default("America/Chicago")
  enabled     Boolean      @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  runSessions RunSession[]
  createdAt   DateTime     @default(now())
}

model Prompt {
  id            String   @id @default(cuid())
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  projectId     String?  // denormalized from Batch for project-scoped queries
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptType    String   // "brand" | "nonbrand"
  category      String
  entityName    String   @default("")  // location / product / service line the prompt is about
  segments      Json?    // arbitrary dimensions, e.g. {"market":"Chicago","levelOfCare":"Memory Care"}
  // Legacy senior-living columns — superseded by entityName/segments, dropped once all readers move over.
  communityName String
  city          String
  market        String
  levelOfCare   String   // "Assisted Living" | "Independent Living" | "Memory Care" | "Skilled Nursing" | "Short Term Care" | ""
  promptText    String
  jobStatus     String   @default("pending")  // "pending" | "running" | "done" | "failed"
  jobError      String?
  results       Result[]
  createdAt     DateTime @default(now())

  @@index([projectId])
}

model Result {
  id           String      @id @default(cuid())
  promptId     String
  prompt       Prompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  runSessionId String?
  runSession   RunSession? @relation(fields: [runSessionId], references: [id])
  platform     String      // "chatgpt" | "claude" | "perplexity" | "gemini" | "google_aio" | "google_ai_mode"
  responseText String
  isMentioned  Boolean     @default(false)
  isCited      Boolean     @default(false)
  sentiment    String      @default("neutral")  // "positive" | "neutral" | "negative"
  brandPosition Int?       // 1-based order the project's brand appears among tracked brands; null if not mentioned
  citations    Citation[]
  competitorMentions CompetitorMention[]  // per-competitor detection; the project's own brand stays on the fields above
  runAt        DateTime    @default(now())
}


model Citation {
  id       String @id @default(cuid())
  resultId String
  result   Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  url      String
  title    String
  domain   String
  // true: the platform explicitly cited/quoted this source in its answer text.
  // false: the source was retrieved by the platform's web search but not directly
  // cited — surfaced separately so it isn't counted toward isMentioned/isCited stats.
  isExplicitCitation Boolean @default(true)
}

// A named competitor tracked against the user's existing prompt set.
model Competitor {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?             // nullable until backfilled — see scripts/backfill-projects.ts
  project   Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandName String
  domain    String              // used to match citation domains (e.g. "brookdale.com")
  aliases   String              @default("")  // comma-separated alternate names scanned in response text
  active    Boolean             @default(true)
  mentions  CompetitorMention[]
  createdAt DateTime            @default(now())

  @@index([projectId])
}

// One row per (Result, Competitor) — mirrors Result.isMentioned/isCited/sentiment
// so competitor mention/citation rates can be computed the same way as the user's own.
model CompetitorMention {
  id           String     @id @default(cuid())
  resultId     String
  result       Result     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  isMentioned  Boolean    @default(false)
  isCited      Boolean    @default(false)
  sentiment    String     @default("neutral")  // "positive" | "neutral" | "negative"
  position     Int?       // 1-based order among tracked brands; null if not mentioned

  @@unique([resultId, competitorId])
}

// Cache for Google Search Console metrics per page URL.
// Populated by the daily `refresh-gsc-cache` Inngest function.
// SQL: CREATE TABLE IF NOT EXISTS "GscMetric" ("id" TEXT NOT NULL PRIMARY KEY, "pageUrl" TEXT NOT NULL UNIQUE, "isIndexed" BOOLEAN NOT NULL DEFAULT false, "impressions" INTEGER NOT NULL DEFAULT 0, "clicks" INTEGER NOT NULL DEFAULT 0, "position" DOUBLE PRECISION, "fetchedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP, "updatedAt" TIMESTAMP(3) NOT NULL);
model GscMetric {
  id          String   @id @default(cuid())
  pageUrl     String   @unique
  isIndexed   Boolean  @default(false)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  position    Float?
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Cache for Google Search Console query-level (search term) metrics — the
// actual phrases people search that surface the connected site. Populated
// by the same daily `refresh-gsc-cache` Inngest function and used to ground
// the prompt-suggestion generator in real search demand.
model GscQuery {
  id          String   @id @default(cuid())
  query       String   @unique
  impressions Int      @default(0)
  clicks      Int      @default(0)
  position    Float?
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Cache for page-level schema markup detection.
// Populated by crawlCommunityPages() after each GSC sync.
// SQL: CREATE TABLE IF NOT EXISTS "PageCrawlResult" ("id" TEXT NOT NULL PRIMARY KEY, "pageUrl" TEXT NOT NULL UNIQUE, "hasLocalBusiness" BOOLEAN, "hasSeniorCare" BOOLEAN, "crawledAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP, "updatedAt" TIMESTAMP(3) NOT NULL);
model PageCrawlResult {
  id               String   @id @default(cuid())
  pageUrl          String   @unique
  hasLocalBusiness Boolean?
  hasSeniorCare    Boolean?
  crawledAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
