# Database
#   DATABASE_URL: transaction pooler (port 6543) — used at runtime for queries
#   DIRECT_URL:   direct connection (port 5432)   — used at build time for schema migrations only
DATABASE_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI platform API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Email notifications (https://resend.com/)
RESEND_API_KEY=

# SearchAPI for Google AI Overviews / AI Mode (https://www.searchapi.io/)
SEARCHAPI_KEY=

# App URL (used for share links — set to your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# App identity — this codebase is deployed twice (Senior Lifestyle app and the
# multi-brand app), each as its own Vercel project with its own database and URL.
# Leave these unset for the Senior Lifestyle deployment; see lib/app-config.ts.
# NEXT_PUBLIC_APP_OWNER_NAME=IDX
# NEXT_PUBLIC_APP_PRODUCT_NAME=AI Visibility Dashboard
# NEXT_PUBLIC_APP_DESCRIPTION=Track how AI assistants mention and cite your brand
# NEXT_PUBLIC_APP_DASHBOARD_TAGLINE=AI mention and citation monitoring across your brands
# NEXT_PUBLIC_APP_LOGO_URL=            # empty = text wordmark instead of a logo image
